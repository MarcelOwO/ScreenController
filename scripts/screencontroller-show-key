#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this command as root." >&2
  exit 1
fi

environment=/etc/screencontroller/screencontroller.env
if [ ! -r "$environment" ]; then
  echo "ScreenController has no provisioning key." >&2
  exit 1
fi

key=$(sed -n 's/^SCREEN_CONTROLLER_PSK_HEX=//p' "$environment")
if [ -z "$key" ]; then
  echo "ScreenController has no valid provisioning key." >&2
  exit 1
fi

case "${1:---uri}" in
  --uri)
    printf 'screencontroller://enroll?v=2&name=ScreenController&key=%s&psm=129\n' "$key"
    ;;
  --key)
    printf '%s\n' "$key"
    ;;
  *)
    echo "Usage: screencontroller-show-key [--uri|--key]" >&2
    exit 2
    ;;
esac
